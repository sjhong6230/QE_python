&control
  calculation = 'scf'
  prefix = 'Si_sym'
  pseudo_dir = '/home/sjhong6230/QE_porting_test/Si_sym_PZ/pseudo'
  outdir = '/tmp/qe_porting_si_sym'
  verbosity = 'high'
/

&system
  ibrav = 2
  celldm(1) = 10.18000000
  nat = 2
  ntyp = 1
  ecutwfc = 80
  occupations = 'fixed'
  noinv = .true.
/

&electrons
  electron_maxstep = 300
  mixing_beta = 0.1
  conv_thr = 1.0e-6
/

ATOMIC_SPECIES
  Si   28.085   Si.upf

ATOMIC_POSITIONS crystal
  Si   0.00000000  0.00000000  0.00000000
  Si   0.25000000  0.25000000  0.25000000

K_POINTS automatic
  6 6 6 0 0 0
