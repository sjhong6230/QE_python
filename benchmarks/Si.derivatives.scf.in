&control
  calculation = 'scf'
  prefix = 'Si_derivatives'
  pseudo_dir = '/home/sjhong6230/qe-7.5/QEHeat/examples/pseudo'
  outdir = '/tmp/qe_porting_si_derivatives'
  tprnfor = .true.
  tstress = .true.
/
&system
  ibrav = 2
  celldm(1) = 10.18
  nat = 2
  ntyp = 1
  ecutwfc = 40.0
  occupations = 'fixed'
  input_dft = 'PBE'
/
&electrons
  conv_thr = 1.0d-10
  electron_maxstep = 120
  mixing_beta = 0.2
/
ATOMIC_SPECIES
Si  28.085  Si_ONCV_PBE-1.1.upf
ATOMIC_POSITIONS crystal
Si  0.00000000  0.00000000  0.00000000
Si  0.26000000  0.25000000  0.25000000
K_POINTS automatic
2 2 2 0 0 0
