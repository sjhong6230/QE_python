&control
  calculation = 'scf'
  prefix = 'Si_pbe'
  pseudo_dir = '/home/sjhong6230/qe-7.5/QEHeat/examples/pseudo'
  outdir = '/tmp/qe_porting_si_pbe'
  verbosity = 'high'
/

&system
  ibrav = 2
  celldm(1) = 10.18000000
  nat = 2
  ntyp = 1
  ecutwfc = 40
  occupations = 'fixed'
  input_dft = 'PBE'
  noinv = .true.
/

&electrons
  electron_maxstep = 300
  mixing_beta = 0.1
  conv_thr = 1.0e-6
/

ATOMIC_SPECIES
  Si   28.085   Si_ONCV_PBE-1.1.upf

ATOMIC_POSITIONS crystal
  Si   0.00000000  0.00000000  0.00000000
  Si   0.25000000  0.25000000  0.25000000

K_POINTS automatic
  6 6 6 0 0 0
