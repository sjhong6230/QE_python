&control
  calculation = 'scf'
  prefix = 'Si_fft_benchmark'
  pseudo_dir = '../../tests/qe_reference/upstream/pseudo'
  outdir = './tmp'
  disk_io = 'none'
  verbosity = 'high'
/

&system
  ibrav = 2
  celldm(1) = 10.20
  nat = 2
  ntyp = 1
  ecutwfc = 160.0
  ecutrho = 640.0
  nbnd = 32
  occupations = 'fixed'
/

&electrons
  electron_maxstep = 12
  mixing_beta = 0.3
  conv_thr = 1.0d-8
  diago_david_ndim = 2
/

ATOMIC_SPECIES
  Si  28.086  Si.pz-vbc.UPF

ATOMIC_POSITIONS {alat}
  Si  0.00  0.00  0.00
  Si  0.25  0.25  0.25

K_POINTS {Gamma}
