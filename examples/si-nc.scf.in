&CONTROL
  calculation = 'scf',
  prefix = 'silicon',
  pseudo_dir = '../quantum-espresso/atomic/examples/pseudo-LDA-0.5/reference',
/
&SYSTEM
  ibrav = 2,
  celldm(1) = 10.20,
  nat = 2,
  ntyp = 1,
  ecutwfc = 12.0,
  nbnd = 4,
  input_dft = 'PZ',
/
&ELECTRONS
  conv_thr = 1.0d-5,
  electron_maxstep = 60,
  mixing_beta = 0.30,
/
ATOMIC_SPECIES
Si  28.086  Si.LDA.0.5.UPF
ATOMIC_POSITIONS alat
Si  0.00  0.00  0.00
Si  0.25  0.25  0.25
K_POINTS gamma
